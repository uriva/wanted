{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wanted",
  "main": "dist/worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js"]
    }
  ],
  "build": {
    "command": "deno run -A scripts/buildWorker.ts"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "wanted.uriv.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
